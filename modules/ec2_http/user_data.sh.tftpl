#!/bin/bash
set -euxo pipefail

if ! command -v python3 >/dev/null 2>&1; then
  if command -v dnf >/dev/null 2>&1; then
    dnf install -y python3
  elif command -v yum >/dev/null 2>&1; then
    yum install -y python3
  elif command -v apt-get >/dev/null 2>&1; then
    apt-get update -y
    DEBIAN_FRONTEND=noninteractive apt-get install -y python3
  else
    echo "No supported package manager found to install python3" >&2
    exit 1
  fi
fi

mkdir -p /opt/demo-http
cat >/opt/demo-http/server.py <<'PY'
from http.server import BaseHTTPRequestHandler, HTTPServer
import os
import socket

MESSAGE = os.environ.get("ENDPOINT_MESSAGE", "hello")


def get_private_ip():
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        sock.connect(("169.254.169.254", 80))
        return sock.getsockname()[0]
    except OSError:
        return "unknown"
    finally:
        sock.close()


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        body = (
            f"message={MESSAGE}\\n"
            f"hostname={socket.gethostname()}\\n"
            f"private_ip={get_private_ip()}\\n"
        )
        self.send_response(200)
        self.send_header("Content-type", "text/plain")
        self.end_headers()
        self.wfile.write(body.encode())

HTTPServer(("0.0.0.0", 8080), Handler).serve_forever()
PY

cat >/etc/systemd/system/demo-http.service <<'SERVICE'
[Unit]
Description=Demo HTTP endpoint on port 8080
After=network.target

[Service]
Type=simple
Environment="ENDPOINT_MESSAGE=${endpoint_message}"
ExecStart=/usr/bin/python3 /opt/demo-http/server.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
SERVICE

systemctl daemon-reload
systemctl enable --now demo-http.service
